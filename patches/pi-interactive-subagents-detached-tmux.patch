+/**
+ * Ensure the dedicated agents session exists and return a pane id inside it
+ * that new subagent panes can be split from. Detached by default so it never
+ * steals the user's terminal; `tmux attach -t pi-agents` shows it on demand.
+ */
+function ensureAgentsSessionPane(): string {
+  if (agentsSessionBasePane) return agentsSessionBasePane;
+  let exists = false;
+  try {
+    execFileSync("tmux", ["has-session", "-t", AGENTS_TMUX_SESSION], {
+      stdio: "ignore",
+    });
+    exists = true;
+  } catch {}
+  if (!exists) {
+    execFileSync(
+      "tmux",
+      ["new-session", "-d", "-s", AGENTS_TMUX_SESSION, "-x", "200", "-y", "50"],
+      { encoding: "utf8" },
+    );
+  }
+  // `-f` pane filtering needs tmux ≥3.2; list unfiltered and filter in-process so
+  // tmux 3.0 (distro apt) works too. `#{pane_marked}` exists since tmux 2.9.
+  const panes = execFileSync(
+    "tmux",
+    ["list-panes", "-t", AGENTS_TMUX_SESSION, "-F", "#{pane_id} #{pane_marked}"],
+    { encoding: "utf8" },
+  ).trim().split("\n").filter(Boolean);
+  let pane = panes.find((l) => l.endsWith(" 1"))?.split(" ")[0];
+  if (!pane) {
+    // No marked pane yet (fresh session): mark the first pane so splits anchor to a
+    // stable base, mirroring the upstream marked-pane assumption.
+    pane = panes[0]?.split(" ")[0];
+    if (!pane?.startsWith("%")) {
+      throw new Error(`Unexpected tmux list-panes output: ${panes.join(" | ")}`);
+    }
+    execFileSync("tmux", ["select-pane", "-t", pane, "-m"], { stdio: "ignore" });
+  }
+  agentsSessionBasePane = pane;
+  return pane;
+}
+
+/**
+ * The pane new subagent panes are split from: the parent pi's pane when pi
+ * runs inside tmux, otherwise a pane in the dedicated agents session.
+ */
+function splitOriginPane(): string {
+  return process.env.TMUX_PANE ?? ensureAgentsSessionPane();
+}
