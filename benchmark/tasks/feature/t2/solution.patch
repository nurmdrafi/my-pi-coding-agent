+/** URL-friendly slug: lowercase, non-alphanumerics collapsed to single hyphens, trimmed. */
+export function slugify(s) {
+  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+}
