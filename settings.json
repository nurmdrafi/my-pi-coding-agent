{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.3.0",
  "theme": "dark",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "deepseek/deepseek-flash": "off",
    "deepseek/deepseek-v4-pro": "off"
  },
  "hideThinkingBlock": true,
  "defaultTools": ["-bash", "-read", "-edit", "+codemode", "+pibash", "+piread", "+piedit", "+pidx"],
  "codemode": {
    "mode": "on",
    "inlineBudget": 3000
  },
  "compaction": {
    "enabled": true,
    "midTurnEnabled": true,
    "strategy": "shake"
  },
  "packages": [],
  "extensions": [
    "-builtin:mcp"
  ]
}